<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.mage</groupId>
        <artifactId>mage-root</artifactId>
        <version>1.4.61</version>
    </parent>

    <artifactId>mage-web-gateway</artifactId>
    <packaging>jar</packaging>
    <name>Mage Web Gateway</name>

    <!--
        Bridges a browser (WebSocket + JSON) to the existing Mage.Server (JBoss Remoting)
        without modifying the game engine. See xmage-llm-bridge-design.md's eventual home:
        a hosted site to practice against LLM bots. This module is a normal remote client
        of Mage.Server, same as Mage.Client - it just re-serializes what it receives.
    -->

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- The actual card implementations (every real card - creatures, spells,
                 etc.) live here, NOT in mage-common/mage. Confirmed the hard way: any
                 non-basic-land card failed with ClassNotFoundException (e.g.
                 mage.cards.s.Shock) at CardImpl.createCard() when this dependency was
                 missing - basic lands alone worked because their classes live in the
                 core `mage` module, already pulled in transitively via mage-common. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-sets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- Real DeckValidator classes (Standard/Modern/Commander/etc.) - without
                 this, DeckValidatorFactory.instance stays empty in the gateway's own
                 JVM (these are normally loaded as external plugins by Mage.Server's
                 Main.java from config.xml, which the gateway never runs), so every
                 createDeckValidator() call returned null and format legality was
                 never actually being checked. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-deck-constructed</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <!-- Lightweight embeddable WebSocket server - no other transitive deps,
                 which matters since this module ships as a jar-with-dependencies. -->
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.7</version>
        </dependency>
        <dependency>
            <!-- For "analyze my deck and build a counter" - same client library the
                 LLM bridge bot already uses (Mage.Player.AI.LLM), same version pin. -->
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.34.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <!-- Runnable fat jar: this module is a deployable service (a gateway
                 process), not a library other modules compile against, so bundling its
                 own dependency closure is the right shape for `java -jar`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>mage.web.gateway.GatewayServer</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
